{
  "name": "galexp3",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-based 4X space game (Master of Orion / Galactic Civilizations style).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec": "quint",
    "spec:simulate": "quint simulate --max-samples=1000 --max-steps=10 quint/galaxy.qnt",
    "spec:check": "quint typecheck quint/galaxy.qnt"
  },
  "dependencies": {},
  "devDependencies": {
    "@informalsystems/quint": "^0.22.0",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
